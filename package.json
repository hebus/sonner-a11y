{
  "name": "sonner-a11y",
  "version": "0.0.0",
  "description": "An accessible toast component for pure JavaScript: screen-reader announcements, full keyboard operation, WCAG 2.2 AA. Fork of sonner-js.",
  "keywords": [
    "a11y",
    "accessibility",
    "aria",
    "keyboard",
    "notification",
    "screen-reader",
    "toast",
    "wcag"
  ],
  "homepage": "https://hebus.github.io/sonner-a11y/",
  "bugs": "https://github.com/hebus/sonner-a11y/issues",
  "license": "MIT",
  "author": "huanfei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebus/sonner-a11y.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build:watch": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.build.json",
    "check:package": "publint && attw --pack . --profile esm-only && node scripts/verify-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.1",
    "@types/trusted-types": "^2.0.7",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "terser": "^5.50.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.0"
}
